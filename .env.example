# === 云端服务配置 (cloud-server.mjs) ===
# 监听地址与端口
CODEX_CLOUD_HOST=0.0.0.0
CODEX_CLOUD_PORT=3280

# 可选：直接启用 HTTPS/WSS（证书和私钥必须同时设置；通常使用 443 端口）
# CODEX_TLS_CERT_FILE=/etc/ssl/codex-remote/server.crt
# CODEX_TLS_KEY_FILE=/etc/ssl/codex-remote/server.key
# CODEX_HTTP_REDIRECT_PORT=80
# CODEX_PUBLIC_ORIGIN=https://remote.example.com

# 登录访问口令（若不设置，首次启动将自动生成并保存在 data/auth.json）
CODEX_ADMIN_PASSWORD=

# TOTP Base32 密钥（若不设置，首次启动自动生成并保存在 data/auth.json，不打印到日志）
CODEX_TOTP_SECRET=

# Cookie 签名密钥（若不设置将自动生成并持久化）
CODEX_COOKIE_SECRET=

# 数据持久化目录
CODEX_DATA_DIR=./data

# === 本地注册脚本配置 (local-agent.mjs / bin/codex-up) ===
# 本机测试默认连接本地网关；部署后改为 wss://remote.example.com/ws/agent
CODEX_RELAY_URL=ws://127.0.0.1:3280/ws/agent

# 使用自签名 CA 的 WSS 时，设置该 CA 证书的绝对路径；仍然校验证书链和主机名。
# CODEX_RELAY_CA_FILE=/absolute/path/codex-remote-ca.crt

# 本机显示名称（默认取操作系统 hostname）
CODEX_AGENT_NAME=

# 默认启动的 Codex Profile（可选，例如 deepseek）
CODEX_PROFILE=

# codex-up 自动管理一个仅监听 127.0.0.1 的 DSH Web，复用 Remote 登录。
# 本机需已安装 dsh；--no-dsh 或 CODEX_DSH_ENABLED=0 可关闭。
CODEX_DSH_ENABLED=1
CODEX_DSH_PORT=3081
# CODEX_DSH_BIN=/absolute/path/to/dsh
# CODEX_DSH_CWD=/home/your-user

# 本机模型服务需要代理时，可取消以下注释；codex-up 会自动导出给子进程。
# 端口应与本机 proxyon / 代理软件配置一致。
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7891
# no_proxy=localhost,127.0.0.1,::1
