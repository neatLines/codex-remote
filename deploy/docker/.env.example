REMOTE_RELAY_URL=wss://124.220.154.235/ws/agent
REMOTE_AGENT_NAME=上海服务器
REMOTE_DATA_DIR=/home/ubuntu/codex-remote/data
REMOTE_TLS_DIR=/etc/ssl/codex-remote
